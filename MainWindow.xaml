<Window x:Class="Batchwork.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Batchwork" Width="1160" Height="760" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"><Grid Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Batchwork" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Rename hundreds of files without losing control." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Preview every change before anything is touched." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  REVERSIBLE PLAN" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid><Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,26,0,18"><StackPanel Orientation="Horizontal"><Button Content="Choose folder" Click="ChooseFolder_Click"/><TextBox x:Name="FindBox" Width="180" Padding="8" TextChanged="RuleChanged"/><TextBlock Text="replace with" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0"/><TextBox x:Name="ReplaceBox" Width="180" Padding="8" TextChanged="RuleChanged"/><Button Content="Apply rename" Click="Apply_Click" Background="{StaticResource Accent}" Foreground="White"/><Button Content="Undo last plan" Click="Undo_Click"/></StackPanel></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><Grid><TextBlock Text="Preview" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Text="No folder selected" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid><ListBox x:Name="PreviewList" Margin="0,12,0,0" Background="White" BorderBrush="{StaticResource Line}"/></StackPanel><Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="RENAME PLAN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Choose a folder to begin." FontSize="17" FontWeight="SemiBold" Margin="0,7,0,16"/><TextBlock Text="Nothing is changed while you are previewing. Conflicts are blocked before execution." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><Separator Margin="0,20,0,14"/><TextBlock Text="SAFE BY DEFAULT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="The last plan can be reversed from this session." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border></Grid><TextBlock Grid.Row="3" Text="Batchwork 1.3.1  ·  MIT licensed" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/></Grid></Window>
